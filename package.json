{
  "name": "checkout-test-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents run end-to-end checkout and payment test scenarios against e-commerce test environments.",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "checkout-test-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "scenarios",
    "test-data",
    "schemas",
    "checkout-test-mcp.config.example.yaml"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "schema": "tsx scripts/generate-schema.ts",
    "demo-store": "node examples/demo-store/server.mjs",
    "smoke": "npm run build && tsx scripts/smoke-stdio.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "playwright": "1.65.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
