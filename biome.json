{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!node_modules",
      "!.checkout-test-mcp",
      "!test/fixtures/shop-src",
      "!schemas/*.json",
      "!**/__snapshots__",
      "!**/*.md"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "javascript": { "formatter": { "quoteStyle": "single" } },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": { "noConsole": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": { "rules": { "suspicious": { "noConsole": "error" } } }
    }
  ]
}
